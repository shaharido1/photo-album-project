{
  "name": "hello-world-fullstack",
  "version": "1.0.0",
  "description": "Hello World full-stack app with Node.js, React-Redux, and Docker",
  "private": true,
  "scripts": {
    "dev": "lsof -ti :3000 -ti :3001 | xargs kill -9 2>/dev/null; npx concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:docker": "docker-compose up",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test && npm --prefix client run test",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "check:deployment": "node scripts/check-deployment.js"
  },
  "keywords": [
    "hello-world",
    "react",
    "redux",
    "nodejs",
    "docker"
  ],
  "author": "Ido Shahar",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
