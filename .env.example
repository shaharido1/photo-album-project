# ===========================================
# Environment Variables - Copy to .env
# ===========================================

# ----- Server Configuration -----
# Port for the Express server (default: 3001)
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# ----- GitHub Configuration -----
# Personal Access Token for GitHub CLI and API
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Render Configuration (for deployment) -----
# Render API Key (optional, for programmatic deployments)
# Get from: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Optional: Docker Hub (if pushing images) -----
# DOCKER_USERNAME=your_dockerhub_username
# DOCKER_PASSWORD=your_dockerhub_password_or_token
