# ===========================================
# Environment Variables - Copy to .env
# ===========================================

# ----- Server Configuration -----
# Port for the Express server (default: 3001, Render uses 10000)
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# ----- GitHub Configuration -----
# Personal Access Token for GitHub CLI and API
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow, write:packages, read:packages
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Render Configuration -----
# Render API Key (for CLI and programmatic deployments)
# Get from: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Render Deploy Hook URL (for triggering deploys from GitHub Actions)
# Get from: Render Dashboard -> Your Service -> Settings -> Deploy Hook
# Add this as a GitHub Secret: RENDER_DEPLOY_HOOK_URL
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxx?key=xxxxx

# Render Service ID (for API calls)
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx

# ----- GitHub Container Registry (GHCR) -----
# Image is automatically pushed to: ghcr.io/<github-username>/<repo-name>
# No additional config needed - uses GITHUB_TOKEN for auth
GHCR_IMAGE=ghcr.io/shaharido1/photo-album-project:latest
