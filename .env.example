# ============================================
# Server Configuration
# ============================================

PORT=3001
VITE_PORT=5173
NODE_ENV=development

# ============================================
# Firebase Admin SDK (Server)
# ============================================
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate a new private key and copy values from the JSON file

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# For FIREBASE_PRIVATE_KEY:
# - Copy the entire private key from the service account JSON
# - Keep the quotes and \n escape sequences
# - Example format: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# Firebase Client SDK (for Vite/React)
# ============================================
# Get these from Firebase Console > Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=VITE_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=VITE_FIREBASE_APP_ID

# ============================================
# Google Photos Integration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google-photos/auth/callback
# 32-byte hex string for encryption
GOOGLE_PHOTOS_ENCRYPTION_KEY=GOOGLE_PHOTOS_ENCRYPTION_KEY
STORAGE_PATH_FOLDER=STORAGE_PATH_FOLDER

CLOUDINARY_SECRET=your-cloudinary-secret
CLOUDINARY_API_KEY=your-cloudinary-api-key